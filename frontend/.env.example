# Leave the backend URLs blank for same-origin access through the Vite proxy.
# Set them to the backend tunnel URLs when the frontend is hosted separately.
VITE_API_BASE_URL=
VITE_WS_URL=

# Origin sent by the local Vite proxy to the backend for CORS/WebSocket checks.
# This is normally the URL used to open the frontend in a browser.
VITE_FRONTEND_ORIGIN=http://localhost:5173
