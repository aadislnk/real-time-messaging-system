# PostgreSQL
POSTGRES_DB=sandesh
POSTGRES_USER=sandesh
POSTGRES_PASSWORD=your_secure_postgres_password_here

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@sandesh.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sandesh
SPRING_DATASOURCE_USERNAME=sandesh
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here

# Spring Data Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT Secret (Base64 encoded 256-bit key)
SANDESH_JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_key_here

# Application Configuration
SERVER_PORT=8080
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
SANDESH_ACCESS_TOKEN_TTL=7d
SANDESH_WS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:4200
SANDESH_RATE_LIMIT_MESSAGES_PER_MINUTE=60
SANDESH_REALTIME_CHANNEL=sandesh:realtime
